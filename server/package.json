{
  "name": "luxestay-backend",
  "version": "1.0.0",
  "description": "Production-grade backend for LuxeStay ERP",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed.ts",
    "test": "vitest",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1004.0",
    "@aws-sdk/s3-request-presigner": "^3.1004.0",
    "@hono/node-server": "^1.19.11",
    "@hono/swagger-ui": "^0.5.3",
    "@hono/zod-validator": "^0.4.3",
    "@paralleldrive/cuid2": "^2.3.1",
    "@sentry/node": "^10.42.0",
    "@sinclair/typebox": "^0.34.48",
    "arctic": "^3.7.0",
    "argon2": "^0.41.1",
    "bullmq": "^5.70.4",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.38.4",
    "hono": "^4.12.5",
    "ioredis": "^5.10.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.1",
    "otplib": "^13.3.0",
    "pino": "^9.14.0",
    "postgres": "^3.4.8",
    "socket.io": "^4.8.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.19.15",
    "drizzle-kit": "^0.30.6",
    "eslint": "^9.39.4",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
